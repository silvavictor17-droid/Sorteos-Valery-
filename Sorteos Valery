            padding-top: 25px;
            text-align: left;
        }

        .campo {
            font-size: 20px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
        }

        .campo label {
            min-width: 140px;
            font-weight: bold;
        }

        .linea {
