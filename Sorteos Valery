            display: inline-block;
            background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
            color: #0A1A3F;
            padding: 14px 30px;
            border-radius: 6px;
            font-size: 17px;
            text-decoration: none;
            font-weight: bold;
            margin: 8px;
            border: 2px solid #F2D898;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .boton:hover {
